<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenicgo.spot.mapper.TagMapper">

    <select id="selectBySpotId" resultType="com.scenicgo.spot.entity.Tag">
        SELECT t.id, t.name, t.type, t.sort
        FROM spot_tag st
                 JOIN tag t ON t.id = st.tag_id
        WHERE st.spot_id = #{spotId}
        ORDER BY t.sort
    </select>
</mapper>
